+# C-332: Debug endpoints were publicly reachable and leaked operational state —
+# which provider keys are unset, raw upstream error bodies (e.g. OpenAI
+# `insufficient_quota` billing detail), exception types, and the configured model
+# string. Lock them down two ways:
+#   1. require_debug_access: must be authenticated AND ALLOW_DEBUG_ENDPOINTS=true
+#      (default OFF → 404 in production, so the route isn't even discoverable).
+#   2. sanitize the response: never echo raw upstream error JSON or exception
+#      strings to the caller; return a coarse reachable/unreachable verdict and
+#      log the detail server-side instead.
+def _debug_enabled() -> bool:
+    return os.getenv("ALLOW_DEBUG_ENDPOINTS", "").strip().lower() in ("1", "true", "yes")
+
+
+async def require_debug_access(auth: AuthedRequest = Depends(require_auth)) -> AuthedRequest:
+    # require_auth already 401s unauthenticated callers. When debug is disabled we
+    # return 404 (not 403) so the endpoint's existence isn't confirmed in prod.
+    if not _debug_enabled():
+        raise HTTPException(status_code=404, detail="Not Found")
+    return auth
+
